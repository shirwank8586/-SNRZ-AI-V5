    }


@app.get("/multi-analysis")
async def multi_analysis():

    all_data = {}

    errors = {}

    timeframes = [

        "1mo",
        "1w",
        "1d",
        "4h",
        "1h",
        "30m",
        "15m",
        "5m"

    ]


    for tf in timeframes:

        try:

            raw =
                await candles(
                    tf,
                    250
                )

            all_data[tf] = [

                Candle(**x)

                for x in raw

            ]

        except Exception as e:

            errors[tf] =
                str(e)


    if not all_data:

        raise HTTPException(

            status_code=502,

            detail=
                "No market data. "
                "Configure "
                "TWELVE_DATA_API_KEY "
                "on the backend."

        )


    result =
        multi_timeframe(
            all_data
        )


    result.update({

        "engine":
            "SNRZ AI V9",

        "mode":
            "paper/educational",

        "method":
            "SNRZ-only",

        "timeframes":
            timeframes,

        "errors":
            errors

    })


    return result


@app.post("/ask-ai")
async def ask_ai(
    req: AskAIRequest
):

    api_key =
        os.getenv(
            "OPENAI_API_KEY"
        )


    if not api_key:

        raise HTTPException(

            status_code=503,

            detail=
                "OPENAI_API_KEY is "
                "not configured on "
                "the backend."

        )


    question =
        req.question.strip()


    if not question:

        raise HTTPException(

            status_code=400,

            detail=
                "Question is empty."

        )


    if len(question) > 2000:

        raise HTTPException(

            status_code=400,

            detail=
                "Question is too long."

        )


    client =
        AsyncOpenAI(
            api_key=api_key
        )


    context =
        req.analysis or {}


    try:

        response =
            await client.responses.create(

                model=
                    OPENAI_MODEL,

                instructions=
                    SYSTEM_PROMPT,

                input=
                    "Dashboard analysis JSON:\\n"
                    + str(context)
                    + "\\n\\nUser question:\\n"
                    + question

            )


        return {

            "answer":
                response.output_text,

            "model":
                OPENAI_MODEL,

            "mode":
                "paper/educational",

            "method":
                "SNRZ-only"

        }


    except Exception as e:

        raise HTTPException(

            status_code=502,

            detail=
                "OpenAI request failed: "
                + str(e)

        )
